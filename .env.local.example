# Backend proxy target: URL of running FastAPI backend (defaults to http://127.0.0.1:8000)
BACKEND_URL=http://127.0.0.1:8000

# Authentication mode:
# "api" = genuine backend session cookies & FastAPI integration (default in production)
# "mock" = local browser-only demo fixtures
NEXT_PUBLIC_AUTH_MODE=api

# Test signing secret for deterministic Playwright test session cookies (isolated test runner only).
# Matches the test backend's isolated AUTH_SECRET. Must NEVER be set to a production key.
TEST_AUTH_SECRET=
